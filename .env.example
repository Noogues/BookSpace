# Copia este archivo a .env y ajusta los valores según tu entorno.
# NODE_ENV lo sobrescribe a "development" docker-compose.dev.yml en modo dev.
DATABASE_URL=postgresql://user:password@postgres:5432/bookspace
NODE_ENV=production
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=bookspace
# Credenciales del usuario (única cuenta con acceso de escritura).
ADMIN_USER=usuario
ADMIN_PASSWORD=contraseña-fuerte
# Clave secreta para firmar la sesión (mínimo 16 caracteres). Genera una con: openssl rand -hex 32
AUTH_SECRET=genera-una-clave-larga-y-aleatoria
# Forzar cookie Secure (no la edites: por defecto habilitada en producción; ponla "false" solo si sirves en HTTP puro con `make server`)
#COOKIE_SECURE=false
# Hostname No-IP (u otro) usado solo con el profile "https" de Caddy.
# Ej: tunombre.ddns.net
DOMAIN=tunombre.ddns.net